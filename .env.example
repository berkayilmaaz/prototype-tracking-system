# Bu dosyayı .env adıyla kopyalayın veya değerleri Portainer Stack
# "Environment variables" bölümünde tanımlayın. Gerçek .env Git'e eklenmez.

TZ=Europe/Istanbul

# Active Directory / LDAP
PT_LDAP_URL=ldaps://ldap.example.local:636
PT_LDAP_DOMAIN=example.local
PT_LDAP_BIND_FORMAT={user}@{domain}
PT_LDAP_BASE_DN=dc=example,dc=local
PT_LDAP_TLS_VERIFY=1

# İlk çalıştırmada oluşturulan yerel yönetici
PT_ADMIN_USER=admin
PT_ADMIN_PASSWORD=BURAYA_EN_AZ_10_KARAKTER_GUCLU_SIFRE

# Yetki ve oturum
PT_DEFAULT_ROLE=viewer
PT_SESSION_HOURS=168

# Uygulama HTTPS ters vekili arkasındaysa 1 yapın.
PT_COOKIE_SECURE=0
PT_BACKUP_KEEP=30
